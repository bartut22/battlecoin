# Solana RPC endpoint. Defaults to a local `solana-test-validator` at
# http://127.0.0.1:8899 to avoid the public devnet faucet's rate limit
# during development. Set to the real devnet URL for the actual demo:
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899
